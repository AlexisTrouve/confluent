# ConfluentTranslator Configuration

# === Proxy Etheryale (provider LLM UNIQUE) ===
# Tout passe par le proxy : OAuth Claude Max+, cache automatique, pas de limite de tokens.
# OpenAI/ChatGPT et les clés providers directes ont été retirés.
ETHERYALE_API_KEY=eai_your-key-here
ETHERYALE_BASE_URL=https://ai.etheryale.com

# Modèle par défaut. Haiku 4.5 = coût minimal ; la qualité vient de l'agent outillé + du gate
# phonotactique (prouvé : traductions 100% valides sur Haiku). Alternatives : claude-sonnet-4-6,
# claude-opus-4-8.
CONFLUENT_MODEL=claude-haiku-4-5-20251001

# === Serveur ===
PORT=3000
JWT_SECRET=your-random-secret-here
